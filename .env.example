# Kinora local configuration
# The app runs with no configuration: the Kinora Engine answers deterministically
# and data is stored in .data/kinora.json.

# Backend: file (default) or supabase.
# For supabase, run supabase/migrations/0001_kinora_state.sql with a secret key.
DATA_BACKEND=file

# Optional LLM (AI SDK 7). Set mode to "llm" or "auto" to enable.
# Ollama Cloud is OpenAI-compatible; any compatible endpoint also works.
KINORA_AI_MODE=engine
KINORA_LLM_BASE_URL=https://ollama.com/v1
KINORA_LLM_MODEL=gemma4:31b
KINORA_LLM_API_KEY=
KINORA_LLM_TIMEOUT_MS=30000

# Supabase (hosted backend; run the migration with a key that can execute DDL)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LiveKit (optional voice room; text and device voice work without it)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Hosted agent dispatch. Leave empty for the default/cloud worker.
# For a local worker registered under a named deployment, set both:
#   KINORA_AGENT_DEPLOYMENT=kinora-dev
#   LIVEKIT_AGENT_DEPLOYMENT=kinora-dev
KINORA_AGENT_NAME=kinora-agent
KINORA_AGENT_DEPLOYMENT=

# LiveKit Inference models used by agents/kinora-voice.
# Cartesia has an EU endpoint; Fish Audio does not (REGION_RESTRICTED on EU).
KINORA_STT_MODEL=assemblyai/universal-3-6-pro
KINORA_STT_LANGUAGE=en
# Speaker diarization for the one shared phone. Leave on for the family room.
KINORA_STT_DIARIZE=1
KINORA_TTS_MODEL=cartesia/sonic-3
KINORA_TTS_VOICE=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc
KINORA_EMPTY_ROOM_GRACE_SECONDS=120

# Optional file-store overrides and e2e reset endpoint.
# KINORA_DATA_DIR=.data
# KINORA_DATA_FILE=kinora.json
# KINORA_TEST_MODE=1

# LiveKit Cloud project (the same project as the Kinora app)
LIVEKIT_URL=wss://kirona-5osvfyrf.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Ollama Cloud (OpenAI-compatible endpoint)
KINORA_LLM_BASE_URL=https://ollama.com/v1
KINORA_LLM_MODEL=gemma4:31b
KINORA_LLM_API_KEY=
OLLAMA_API_KEY=

# LiveKit Inference models. Cartesia Sonic 3 has an EU endpoint; Fish Audio
# models do not, so they fail with REGION_RESTRICTED on EU-hosted agents.
KINORA_STT_MODEL=assemblyai/universal-3-6-pro
KINORA_STT_LANGUAGE=en
# Speaker diarization for the one shared phone. Leave on for the family room.
KINORA_STT_DIARIZE=1
KINORA_TTS_MODEL=cartesia/sonic-3
KINORA_TTS_VOICE=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc
KINORA_EMPTY_ROOM_GRACE_SECONDS=120

# Dispatch name. Keep in sync with src/app/api/livekit/dispatch/route.ts.
KINORA_AGENT_NAME=kinora-agent

# LiveKit worker deployment. Leave empty for the hosted default worker; set
# kinora-dev only when running a named local deployment and matching the app's
# KINORA_AGENT_DEPLOYMENT.
LIVEKIT_AGENT_DEPLOYMENT=
